# Stripe secret key (sk_test_... for testing, sk_live_... in production)
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of the webhook endpoint pointing to <server>/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Shared key the POS devices send as "Authorization: Bearer <key>"
POS_API_KEY=change-me-long-random-string
# Terminal location with offline mode enabled (npm run setup:terminal)
STRIPE_LOCATION_ID=tml_xxx
POS_CURRENCY=eur
# Offline risk limits, in minor units (cents)
OFFLINE_MAX_TRANSACTION_AMOUNT=10000
OFFLINE_MAX_STORED_AMOUNT=100000
