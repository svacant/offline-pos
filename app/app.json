{
  "expo": {
    "name": "Offline POS",
    "slug": "offline-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.svacant.offlinepos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.svacant.offlinepos"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "La posizione è richiesta da Stripe Terminal per accettare pagamenti con carta.",
          "bluetoothPeripheralPermission": "Il Bluetooth serve per collegare il lettore di carte.",
          "bluetoothAlwaysUsagePermission": "Il Bluetooth serve per collegare il lettore di carte."
        }
      ]
    ],
    "scheme": "offlinepos"
  }
}
