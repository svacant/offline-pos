# URL of the deployed backend (server/)
EXPO_PUBLIC_POS_BACKEND_URL=https://offline-pos-server.onrender.com
# Same value as POS_API_KEY on the server
EXPO_PUBLIC_POS_API_KEY=change-me
# Optional fallbacks used before the app has reached the backend once
EXPO_PUBLIC_STRIPE_LOCATION_ID=
EXPO_PUBLIC_POS_CURRENCY=eur
